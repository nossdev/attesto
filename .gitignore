# mise — local/per-machine overrides and secrets
.mise.local.toml

# Environment files (anything .env*, but keep the example)
.env
.env.*
!.env.example

# Deno
# Keep deno.lock committed for reproducibility; exclude caches.
.deno/
coverage/

# Build output
dist/
attesto          # compiled single-file binary from `deno compile`

# Docker volumes (if someone runs bind-mounts)
pgdata/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Fly.io
.fly/

# Test artifacts
*.test.log
tests/fixtures/local-*
