# mise — local/per-machine overrides and secrets
.mise.local.toml

# Environment files (anything .env*, but keep the example)
.env
.env.*
!.env.example

# Deno
# Keep deno.lock committed for reproducibility; exclude caches.
.deno/
coverage/

# Created by `deno run --node-modules-dir=auto` for drizzle-kit CJS interop.
# Also covers `docs/node_modules` from the VitePress site.
node_modules/

# Build output
dist/
attesto          # compiled single-file binary from `deno compile`

# VitePress build cache (docs/)
.vitepress/cache

# Docker volumes (if someone runs bind-mounts)
pgdata/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Fly.io
.fly/

# Test artifacts
*.test.log
tests/fixtures/local-*

# Personal working notes — never committed (contains ephemeral URLs, account IDs, checklists).
PHASE*_SETUP.md
SETUP_NOTES.md
TODO.local.md
*.local.md
