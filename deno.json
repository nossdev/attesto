{
  "name": "@nossdev/attesto",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --env-file=.env src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write",
    "test:watch": "deno test --watch --allow-net --allow-env --allow-read --allow-write",
    "test:cov": "deno test --allow-net --allow-env --allow-read --allow-write --coverage=coverage && deno coverage coverage --detailed",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/main.ts",
    "db:generate": "deno run -A --node-modules-dir=auto npm:drizzle-kit@^0.27 generate",
    "db:migrate": "deno run --allow-net --allow-env --allow-read src/main.ts migrate",
    "cli": "deno run --allow-net --allow-env --allow-read cli/attesto-admin.ts"
  },
  "imports": {
    "@/": "./src/",
    "@hono/hono": "jsr:@hono/hono@^4.6",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/ulid": "jsr:@std/ulid@^1",
    "drizzle-orm": "npm:drizzle-orm@^0.36",
    "drizzle-orm/": "npm:/drizzle-orm@^0.36/",
    "postgres": "npm:postgres@^3.4",
    "zod": "npm:zod@^3.23"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": ["coverage/", "migrations/", "PLAN.md", "CHANGELOG.md"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["coverage/", "migrations/"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "exclude": ["coverage/", "node_modules/", "dist/"]
}
