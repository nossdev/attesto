# Attesto environment variables.
#
# Local dev: prefer .mise.local.toml (loaded automatically by mise).
# This .env.example is for Docker / CI / non-mise deployments.
#
# Copy to .env and fill in values. .env is gitignored.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info                          # trace | debug | info | warn | error
NODE_ENV=production                     # development | production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://attesto:attesto@db:5432/attesto

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ATTESTO_ENCRYPTION_KEY=

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200

# ─── Webhook delivery ─────────────────────────────────────────────────────────
# Cap on retry attempts (excluding the first attempt). Default matches the
# hardcoded backoff schedule (delivery.ts: RETRY_SCHEDULE_SECONDS).
WEBHOOK_MAX_RETRIES=5
# Dispatcher poll interval — how often the loop scans for due deliveries.
# NOT the retry delay (those backoffs are hardcoded in delivery.ts).
WEBHOOK_DISPATCH_INTERVAL_SECONDS=10
# Max concurrent in-flight outbound deliveries per tick.
WEBHOOK_DISPATCH_CONCURRENCY=10
# Per-attempt HTTP timeout for delivering to the tenant's callback URL.
WEBHOOK_TIMEOUT_SECONDS=10

# ─── Feature flags ────────────────────────────────────────────────────────────
# Append-only log of every verify request (identifier stored as HMAC-keyed
# hash, not raw). Table grows unbounded — configure a retention job before
# enabling long-term. Off by default.
ENABLE_VALIDATION_AUDIT_LOG=false

# NOTE: Tenant/key/credential/webhook admin is via the compiled `attesto`
# binary's CLI subcommands (e.g. `attesto tenant:create`), not an HTTP API.
# There is no ADMIN_API_TOKEN knob — running the binary with DATABASE_URL +
# ATTESTO_ENCRYPTION_KEY is the auth boundary.
